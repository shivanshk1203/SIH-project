# Copy this file to ".env" in the same folder (backend/) and fill in your real key.
# Get a free FIRMS MAP_KEY here: https://firms.modaps.eosdis.nasa.gov/api/map_key/

FIRMS_MAP_KEY=your_key_here

# Optional. Comma-separated list of origins allowed to call this API in production
# (e.g. https://your-frontend.example.com). Leave unset or "*" for local development,
# where the Vite dev server proxies API calls and CORS doesn't come into play.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
