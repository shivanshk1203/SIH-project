# Copy this file to ".env" in the frontend/ folder if you need it (optional).
#
# In development you don't need this file: Vite's dev server proxies /api/*
# straight to the backend (see vite.config.ts), so relative fetches just work.
#
# Set this only when the built frontend (npm run build) is deployed separately
# from the backend, e.g. frontend on Vercel/Netlify and backend on Render/Fly.
# Leave it unset to keep using relative "/api/..." calls.
VITE_API_BASE_URL=http://localhost:8000
